<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX package's manifest. Build-Package.ps1 fills in the $…$ values: the identity comes from Partner Center
  (Product management, Product identity), the version from Blackwater.App.csproj.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="$Architecture$" />

  <Properties>
    <DisplayName>Blackwater Exchange</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Uploads your Forever Craft Assistant gold ledger to blackwater.exchange, keeps auction prices in the addon fresh and keeps the addon up to date, for WoW Forever.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-GB" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="BlackwaterExchange.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Blackwater Exchange"
        Description="Your WoW Forever gold ledger, auction prices and Forever Craft Assistant, kept up to date."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Blackwater" />
      </uap:VisualElements>
      <Extensions>
        <!-- Starts the app in the notification area at sign-in. Players switch it in Settings, Apps, Startup. -->
        <uap5:Extension Category="windows.startupTask" Executable="BlackwaterExchange.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="BlackwaterExchangeStartup" Enabled="true" DisplayName="Blackwater Exchange" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Downloads prices and addon updates and uploads the ledger. -->
    <Capability Name="internetClient" />
    <!-- A desktop (WPF) app: it reads the game's saved files and writes to its AddOns folder. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
