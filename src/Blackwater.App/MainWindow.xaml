<Window x:Class="BlackwaterExchange.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackwater Exchange" Width="520" Height="760" MinWidth="440" MinHeight="520"
        Icon="{StaticResource Logo}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Style="{StaticResource {x:Type Window}}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="20,18,20,14">
      <Image Source="{StaticResource BrandLockup}" Height="45" HorizontalAlignment="Left"
             AutomationProperties.Name="Blackwater Exchange" />
      <TextBlock x:Name="BusyText" Text="Working…" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Visibility="Collapsed" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,14,6">
      <StackPanel Margin="0,0,6,0">
        <!-- Something the player needs to do. -->
        <Border x:Name="ProblemBox" Background="{StaticResource BadTint}" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                Visibility="Collapsed">
          <TextBlock x:Name="ProblemText" TextWrapping="Wrap" />
        </Border>

        <!-- Account: not linked, linking, linked. -->
        <Border Style="{StaticResource Card}">
          <Grid>
            <StackPanel x:Name="UnlinkedPanel">
              <TextBlock Text="Link to your account" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,12"
                         Text="Link this PC to your Blackwater Exchange account and the app uploads your gold ledger whenever you log out of WoW. You sign in with Discord on the website." />
              <Button x:Name="LinkButton" Content="Link this PC" Style="{StaticResource Primary}" HorizontalAlignment="Left"
                      Click="Link_Click" />
            </StackPanel>

            <StackPanel x:Name="LinkingPanel" Visibility="Collapsed">
              <TextBlock Text="Enter this code on the website" Style="{StaticResource Heading}" />
              <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,10"
                         Text="The link page has opened in your browser. Sign in with Discord if it asks, check the code matches, then choose Link this device." />
              <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                      CornerRadius="6" Padding="18,10" HorizontalAlignment="Left">
                <TextBlock x:Name="CodeText" FontFamily="Cascadia Mono, Consolas" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentStrong}" Text="ABCD-1234" />
              </Border>
              <TextBlock x:Name="LinkWaitText" Text="Waiting for you to approve it…" Style="{StaticResource MutedText}" Margin="0,10,0,10" />
              <WrapPanel>
                <Button Content="Open the page again" Click="OpenLinkPage_Click" Margin="0,0,8,0" />
                <Button Content="Copy code" Click="CopyCode_Click" Margin="0,0,8,0" />
                <Button Content="Cancel" Click="CancelLink_Click" />
              </WrapPanel>
            </StackPanel>

            <Grid x:Name="LinkedPanel" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource Heading}">
                  <Run Text="Linked to" /> <Run x:Name="UserText" Text="Player" Foreground="{StaticResource Accent}" />
                </TextBlock>
                <TextBlock x:Name="DeviceText" Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="as this PC" />
              </StackPanel>
              <Button Grid.Column="1" Content="Open my ledger" VerticalAlignment="Center" Click="OpenLedger_Click" />
            </Grid>
          </Grid>
        </Border>

        <!-- Ledger -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Gold ledger uploads" Style="{StaticResource Heading}" VerticalAlignment="Center" />
              <Button x:Name="UploadButton" Content="Upload now" HorizontalAlignment="Right" Click="UploadNow_Click" />
            </Grid>
            <TextBlock x:Name="UploadText" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="UploadWhen" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0"
                       Text="Playing? Press Sync in the addon's Ledger tab (or type /reload) to send your latest gold without leaving the game." />
          </StackPanel>
        </Border>

        <!-- Prices -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Auction prices in the addon" Style="{StaticResource Heading}" VerticalAlignment="Center" />
              <Button x:Name="PricesButton" Content="Update now" HorizontalAlignment="Right" Click="PricesNow_Click" />
            </Grid>
            <TextBlock x:Name="PricesText" Margin="0,8,0,0" TextWrapping="Wrap" Text="Not checked yet." />
            <TextBlock x:Name="HousesText" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
          </StackPanel>
        </Border>

        <!-- Updates -->
        <Border x:Name="UpdatesCard" Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Updates" Style="{StaticResource Heading}" VerticalAlignment="Center" />
              <Button x:Name="CheckVersionsButton" Content="Check versions" HorizontalAlignment="Right" Click="CheckVersions_Click" />
            </Grid>
            <TextBlock Text="Blackwater Exchange" FontWeight="SemiBold" Margin="0,9,0,0" />
            <TextBlock x:Name="AppReleaseText" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
            <Button Style="{StaticResource LinkButton}" Content="GitHub releases" Click="OpenGitHub_Click"
                    HorizontalAlignment="Left" Margin="0,5,0,0" />
            <Border Height="1" Background="{StaticResource Line}" Margin="0,11,0,10" />
            <TextBlock Text="Forever Craft Assistant" FontWeight="SemiBold" />
            <TextBlock x:Name="AddonReleaseText" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
            <WrapPanel Margin="0,5,0,0">
              <Button Style="{StaticResource LinkButton}" Content="CurseForge files" Click="OpenCurseForge_Click" Margin="0,0,16,0" />
              <Button x:Name="AddonButton" Style="{StaticResource LinkButton}" Content="Install from Blackwater" Click="AddonNow_Click" />
            </WrapPanel>
            <TextBlock x:Name="AddonInstallText" Style="{StaticResource MutedText}" Margin="0,5,0,0" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <!-- Settings -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource Heading}" Margin="0,0,0,8" />
            <TextBlock Text="WoW Forever folder" Foreground="{StaticResource Muted}" />
            <Grid Margin="0,4,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="GameFolderText" Text="Not found" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Button Grid.Column="1" Content="Change…" Click="ChooseFolder_Click" />
            </Grid>
            <CheckBox x:Name="UploadToggle" Content="Upload my gold ledger after I play" Click="Toggle_Click" />
            <CheckBox x:Name="PricesToggle" Content="Keep auction prices in the addon up to date" Click="Toggle_Click" />
            <CheckBox x:Name="AddonToggle" Content="Automatically update the addon from Blackwater" Click="Toggle_Click" />
            <CheckBox x:Name="StartupToggle" Content="Start with Windows, in the notification area" Click="Startup_Click" />
            <Button x:Name="StartupSettingsLink" Style="{StaticResource LinkButton}" Content="Change this in Windows Settings, Apps, Startup"
                    HorizontalAlignment="Left" Margin="0,0,0,6" Click="StartupSettings_Click" Visibility="Collapsed" />
            <TextBlock Text="This PC's name on the website" Foreground="{StaticResource Muted}" Margin="0,8,0,4" />
            <TextBox x:Name="DeviceNameBox" MaxLength="60" LostFocus="DeviceName_LostFocus" />
            <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,4,0,0"
                       Text="Used the next time you link. It is how you tell your PCs apart on your account page." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel VerticalAlignment="Center">
          <Button Style="{StaticResource LinkButton}" Content="Website" Click="OpenWebsite_Click" Margin="0,0,16,0" />
          <Button Style="{StaticResource LinkButton}" Content="Activity log" Click="OpenLog_Click" Margin="0,0,16,0" />
          <Button x:Name="VersionLink" Style="{StaticResource LinkButton}" Click="ShowUpdates_Click" />
        </WrapPanel>
        <Button x:Name="UnlinkButton" Grid.Column="1" Style="{StaticResource LinkButton}" Content="Unlink this PC" Margin="12,0,0,0"
                Foreground="{StaticResource Bad}" Click="Unlink_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
